{
  "name": "mini-lia",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mini-LIA — extração de formulários jurídicos a partir de PDFs, com RAG.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "dev:local": "node scripts/dev-local.js",
    "seed": "node src/seed.js",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test src/lib src/services",
    "test:e2e": "node scripts/e2e.js",
    "test:delivery": "node scripts/verify-delivery.js",
    "test:http": "node scripts/assert-http-contract.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "mongoose": "^8.8.3",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "1.1.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.2"
  }
}
